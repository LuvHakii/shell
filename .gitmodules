[submodule "nushell"]
	path = nushell
	url = https://github.com/nushell/nushell.git
	shallow = true
[submodule "coreutils"]
	path = coreutils
	url = https://github.com/uutils/coreutils.git
	shallow = true
[submodule "grep"]
	path = grep
	url = https://github.com/uutils/grep.git
	shallow = true
[submodule "sed"]
	path = sed
	url = https://github.com/uutils/sed.git
	shallow = true
[submodule "findutils"]
	path = findutils
	url = https://github.com/uutils/findutils.git
	shallow = true
[submodule "awk"]
	path = awk
	url = https://github.com/onetrueawk/awk.git
	shallow = true
